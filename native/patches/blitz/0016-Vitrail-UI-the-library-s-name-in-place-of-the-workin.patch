index 588430c..f4bc634 100644
--- a/packages/blitz-dom/assets/default.css
+++ b/packages/blitz-dom/assets/default.css
@@ -177,10 +177,10 @@ legend {
     padding-inline-end: 2px;
 }
 
-/* webui-lab: <select> drawn by the library. The closed box shows the chosen option (:checked); the others are laid
+/* vitrail-ui: <select> drawn by the library. The closed box shows the chosen option (:checked); the others are laid
    laid in the same grid cell, hidden, so the box is as wide as the widest option, as in Chrome. The arrow is a background image. Open,
-   the library lays a <webui-popup> of <webui-option>s over the page (styleable: webui-popup, webui-option,
-   webui-option[current], webui-option[checked], webui-optgroup). */
+   the library lays a <vitrail-popup> of <vitrail-option>s over the page (styleable: vitrail-popup, vitrail-option,
+   vitrail-option[current], vitrail-option[checked], vitrail-optgroup). */
 select {
     display: inline-grid;
     box-sizing: border-box;
@@ -207,7 +207,7 @@ select:focus-visible { outline: 2px solid #4D90FE; }
 option {
     display: none;
 }
-webui-popup {
+vitrail-popup {
     display: block;
     position: fixed;
     z-index: 2147483647;
@@ -224,11 +224,11 @@ webui-popup {
     white-space: nowrap;
     user-select: none;
 }
-webui-option { display: block; padding: 2px 8px; cursor: default; }
-webui-option[current] { background: #1a73e8; color: white; }
-webui-option[disabled] { color: #8c8c8c; }
-webui-optgroup { display: block; padding: 2px 6px; font-weight: bold; }
-webui-optgroup + webui-option, webui-optgroup ~ webui-option { padding-left: 16px; }
+vitrail-option { display: block; padding: 2px 8px; cursor: default; }
+vitrail-option[current] { background: #1a73e8; color: white; }
+vitrail-option[disabled] { color: #8c8c8c; }
+vitrail-optgroup { display: block; padding: 2px 6px; font-weight: bold; }
+vitrail-optgroup + vitrail-option, vitrail-optgroup ~ vitrail-option { padding-left: 16px; }
 
 source {
     display: none;
