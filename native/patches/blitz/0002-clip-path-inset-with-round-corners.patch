diff --git a/packages/blitz-paint/src/render/clip_path.rs b/packages/blitz-paint/src/render/clip_path.rs
index dcef5a4..8f6acd5 100644
--- a/packages/blitz-paint/src/render/clip_path.rs
+++ b/packages/blitz-paint/src/render/clip_path.rs
@@ -163,8 +163,23 @@ impl ElementCx<'_, '_> {
                     return None;
                 }
 
-                // TODO: Support border-radius on inset()
-                Some(kurbo::Rect::new(x0, y0, x1, y1).into_path(0.1))
+                // webui-lab: `round` corners (elliptical, shrunk together when they overlap, as border-radius).
+                let r = &inset_rect.round;
+                let (bw, bh) = (x1 - x0, y1 - y0);
+                let corner = |c: &style::values::generics::size::Size2D<style::values::generics::NonNegative<LengthPercentage>>| {
+                    Vec2::new(resolve_lp(&c.width.0, bw), resolve_lp(&c.height.0, bh))
+                };
+                let radii = crate::kurbo_css::NonUniformRoundedRectRadii {
+                    top_left: corner(&r.top_left.0),
+                    top_right: corner(&r.top_right.0),
+                    bottom_right: corner(&r.bottom_right.0),
+                    bottom_left: corner(&r.bottom_left.0),
+                };
+                let rect = kurbo::Rect::new(x0, y0, x1, y1);
+                if [radii.top_left, radii.top_right, radii.bottom_right, radii.bottom_left].iter().all(|v| v.x <= 0.0 || v.y <= 0.0) {
+                    return Some(rect.into_path(0.1));
+                }
+                Some(crate::kurbo_css::CssBox::new(rect, kurbo::Insets::ZERO, kurbo::Insets::ZERO, 0.0, radii).border_box_path())
             }
             GenericBasicShape::PathOrShape(path_or_shape) => match path_or_shape {
                 GenericPathOrShapeFunction::Path(path) => svg_path_to_bezpath(
