From 64b46062d9154c5538f19e81aacdfbbd57d45dcd Mon Sep 17 00:00:00 2001
From: Yaroslav Kostiuk <yaroslav0378@gmail.com>
Date: Mon, 9 Nov 2026 02:09:46 +0200
Subject: [PATCH 11/13] Retained painting: elements reuse their last recording
 unless damaged (scroll, composited, background loads mark them)

---
 packages/blitz-dom/src/document.rs      |  9 +++
 packages/blitz-dom/src/layout/damage.rs |  2 +
 packages/blitz-dom/src/scrolling.rs     |  5 ++
 packages/blitz-paint/src/lib.rs         | 27 ++++++++-
 packages/blitz-paint/src/render.rs      | 76 +++++++++++++++++++++++++
 5 files changed, 118 insertions(+), 1 deletion(-)

diff --git a/packages/blitz-dom/src/document.rs b/packages/blitz-dom/src/document.rs
index f6aaa5f..8cff848 100644
--- a/packages/blitz-dom/src/document.rs
+++ b/packages/blitz-dom/src/document.rs
@@ -380,6 +380,11 @@ pub struct BaseDocument {
     /// webui-lab: when set, scroll containers' content is painted unscrolled between scroll markers, with this much
     /// extra content (CSS px) beyond each side of the scrollport, for the embedder to scroll on the GPU.
     pub gpu_scroll_margin: Option<f64>,
+    /// webui-lab: retained painting. Nodes damaged since the last paint (gathered while `resolve` clears damage); an
+    /// element is repainted when it or anything inside it is here, else its last recording is reused.
+    pub paint_dirty: std::sync::Mutex<HashSet<NodeId>>,
+    /// webui-lab: each element's last recording, kept by the painter (blitz-paint's type, so stored as `Any`).
+    pub paint_cache: std::sync::Mutex<HashMap<NodeId, Box<dyn std::any::Any + Send>>>,
     /// Whether there is a `<canvas>` element in the DOM (so we should re-render every frame)
     pub(crate) has_canvas: bool,
     /// Whether there are subdocuments that are animating (so we should re-render every frame)
@@ -568,6 +573,8 @@ impl BaseDocument {
             mousedown_node_id: None,
             has_active_animations: false,
             composited: HashSet::new(),
+            paint_dirty: Default::default(),
+            paint_cache: Default::default(),
             gpu_scroll_margin: None,
             subdoc_is_animating: false,
             has_canvas: false,
@@ -1552,6 +1559,8 @@ impl BaseDocument {
                         layer_image.status = Status::Ok;
                         layer_image.image = image.clone();
                     }
+                    // webui-lab: a loaded background damages nothing, but the element's painting changed.
+                    self.paint_dirty.lock().unwrap().insert(node_id);
                 }
             }
         }
diff --git a/packages/blitz-dom/src/layout/damage.rs b/packages/blitz-dom/src/layout/damage.rs
index 3ebe0e7..d6e6034 100644
--- a/packages/blitz-dom/src/layout/damage.rs
+++ b/packages/blitz-dom/src/layout/damage.rs
@@ -304,6 +304,8 @@ impl BaseDocument {
         if !has_damage && !node.has_damaged_descendants() && !is_anonymous {
             return;
         }
+        // webui-lab: what changed since the last paint (retained painting repaints these and their ancestors).
+        if has_damage { self.paint_dirty.lock().unwrap().insert(node_id); }
         let anonymous_blocks = std::mem::take(&mut node.anonymous_blocks);
         let children = std::mem::take(&mut node.children);
         let (before, after) = (node.before(), node.after());
diff --git a/packages/blitz-dom/src/scrolling.rs b/packages/blitz-dom/src/scrolling.rs
index 7de35ee..5e3abb3 100644
--- a/packages/blitz-dom/src/scrolling.rs
+++ b/packages/blitz-dom/src/scrolling.rs
@@ -295,6 +295,9 @@ impl BaseDocument {
             ScrollTarget::Viewport => {
                 let initial = self.viewport_scroll();
                 self.set_viewport_scroll(offset);
+                // webui-lab: the whole page moved (retained painting).
+                let root = self.root_element().id;
+                self.paint_dirty.lock().unwrap().insert(root);
                 if offset == initial {
                     return false;
                 }
@@ -327,6 +330,8 @@ impl BaseDocument {
                 if offset == initial {
                     return false;
                 }
+                // webui-lab: scrolling damages nothing, but the container's painting changed (retained painting).
+                self.paint_dirty.lock().unwrap().insert(node_id);
 
                 let scroll_width = node.scroll_width();
                 let scroll_height = node.scroll_height();
diff --git a/packages/blitz-paint/src/lib.rs b/packages/blitz-paint/src/lib.rs
index 1754970..05eae21 100644
--- a/packages/blitz-paint/src/lib.rs
+++ b/packages/blitz-paint/src/lib.rs
@@ -59,7 +59,23 @@ pub fn paint_scene(
     #[cfg(feature = "custom-widget")]
     build_custom_widget_scenes(&mut custom_widget_scenes, doc, scene, scale);
 
-    let generator = BlitzDomPainter::new(
+    // webui-lab: retained painting: the damaged nodes and their ancestors are walked again, the rest reused.
+    let retained = (std::env::var_os("BLITZ_NO_RETAIN").is_none()).then(|| {
+        let dirty: std::collections::HashSet<NodeId> = std::mem::take(&mut *doc.paint_dirty.lock().unwrap());
+        let mut dirty_up = std::collections::HashSet::with_capacity(dirty.len() * 8);
+        for &d in &dirty {
+            let mut cur = Some(d);
+            while let Some(id) = cur {
+                if !dirty_up.insert(id) { break; }
+                let n = doc.get_node(id);
+                cur = n.and_then(|n| n.parent.or(n.layout_parent.get()));
+            }
+        }
+        let cache = std::mem::take(&mut *doc.paint_cache.lock().unwrap());
+        let cache: HashMap<NodeId, render::RetainedEntry> = cache.into_iter().filter_map(|(k, v)| v.downcast::<render::RetainedEntry>().ok().map(|e| (k, *e))).collect();
+        render::Retained { dirty_up, cache: std::cell::RefCell::new(cache), volatile: std::cell::Cell::new(false) }
+    });
+    let mut generator = BlitzDomPainter::new(
         doc,
         scale,
         width,
@@ -68,7 +84,16 @@ pub fn paint_scene(
         y_offset as f64,
         &custom_widget_scenes,
     );
+    generator.retained = retained;
     generator.paint_scene(scene);
+    // Keep what this paint used (elements gone or off screen are dropped).
+    if let Some(r) = generator.retained.take() {
+        let kept: HashMap<NodeId, Box<dyn std::any::Any + Send>> = r.cache.into_inner().into_iter()
+            .filter(|(_, e)| e.used)
+            .map(|(k, mut e)| { e.used = false; (k, Box::new(e) as Box<dyn std::any::Any + Send>) }).collect();
+        drop(generator);
+        *doc.paint_cache.lock().unwrap() = kept;
+    }
 
     // println!(
     //     "Rendered using {} clips (depth: {}) (wanted: {})",
diff --git a/packages/blitz-paint/src/render.rs b/packages/blitz-paint/src/render.rs
index 6157cdc..a2dabd8 100644
--- a/packages/blitz-paint/src/render.rs
+++ b/packages/blitz-paint/src/render.rs
@@ -114,6 +114,34 @@ impl<'a> PhysicalTracks<'a> {
 
 /// A short-lived struct which holds a bunch of parameters for rendering a scene so
 /// that we don't have to pass them down as parameters
+/// webui-lab: retained painting. Each element's last recording, kept with what it was painted for; an element neither
+/// damaged since nor holding anything damaged, painted for the same place, appends it as a shared group instead of
+/// walking its subtree again.
+pub struct Retained {
+    /// Damaged nodes and all their ancestors.
+    pub(crate) dirty_up: std::collections::HashSet<NodeId>,
+    pub(crate) cache: RefCell<HashMap<NodeId, RetainedEntry>>,
+    /// Set while recording when something inside can't be kept (a text field): the recording is then not reused.
+    pub(crate) volatile: std::cell::Cell<bool>,
+}
+
+pub struct RetainedEntry {
+    pub(crate) key: [f64; 17],
+    pub(crate) group: Arc<Vec<anyrender::recording::RenderCommand>>,
+    pub(crate) volatile: bool,
+    pub(crate) used: bool,
+}
+
+/// What an element's recording was made for: the transform and cull rectangle it was painted under, its box, its
+/// scroll offset (scrolling damages nothing), the scale.
+fn retained_key(t: Affine, clip: Rect, node: &Node, scale: f64) -> [f64; 17] {
+    let c = t.as_coeffs();
+    let l = node.final_layout();
+    let so = node.scroll_offset();
+    [c[0], c[1], c[2], c[3], c[4], c[5], clip.x0, clip.y0, clip.x1, clip.y1,
+        l.location.x as f64, l.location.y as f64, l.size.width as f64, l.size.height as f64, so.x, so.y, scale]
+}
+
 pub struct BlitzDomPainter<'dom, 'a> {
     /// Input parameters (read only) for generating the Scene
     pub(crate) dom: &'dom BaseDocument,
@@ -134,6 +162,8 @@ pub struct BlitzDomPainter<'dom, 'a> {
     pub(crate) draw_text_context: RefCell<DrawTextContext>,
     /// Cached selection ranges for O(1) lookup: node_id -> (start_offset, end_offset)
     pub(crate) selection_ranges: HashMap<NodeId, (usize, usize)>,
+    /// webui-lab: retained painting (None: paint everything).
+    pub(crate) retained: Option<Retained>,
 
     // Pre-computed `Scene`s for each CustomWidget
     pub(crate) custom_widget_scenes: &'a CustomWidgetSceneMap,
@@ -175,6 +205,7 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
             draw_text_context: RefCell::new(DrawTextContext::default()),
             selection_ranges,
             custom_widget_scenes,
+            retained: None,
         }
     }
 
@@ -760,6 +791,51 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
     ) {
         let node = &self.dom.as_ref().tree()[node_id];
 
+        match &node.data {
+            NodeData::Element(_) | NodeData::AnonymousBlock(_) if self.retained.is_some() => {
+                let r = self.retained.as_ref().unwrap();
+                let key = retained_key(parent_style_transform, clip_rect, node, self.scale);
+                // Unchanged since it was painted, and painted for the same place: its recording again.
+                if !r.dirty_up.contains(&node_id) {
+                    if let Some(e) = r.cache.borrow_mut().get_mut(&node_id) {
+                        if !e.volatile && e.key == key {
+                            e.used = true;
+                            scene.append_group(&e.group);
+                            return;
+                        }
+                    }
+                }
+                let mut sub = Scene::new();
+                let outer = r.volatile.replace(false);
+                self.render_node_now(&mut sub, node_id, parent_style_transform, clip_rect);
+                let volatile = r.volatile.get() || self.volatile(node);
+                r.volatile.set(outer || volatile);
+                let group = Arc::new(sub.commands);
+                scene.append_group(&group);
+                r.cache.borrow_mut().insert(node_id, RetainedEntry { key, group, volatile, used: true });
+            }
+            _ => self.render_node_now(scene, node_id, parent_style_transform, clip_rect),
+        }
+    }
+
+    /// webui-lab: what an element's painting depends on beyond its damage: text fields (their editor changes without
+    /// damage), selected text, custom widgets.
+    fn volatile(&self, node: &Node) -> bool {
+        node.element_data().is_some_and(|e| e.text_input_data().is_some())
+            || self.selection_ranges.contains_key(&node.id)
+            || self.custom_widget_scenes.contains_key(&(self.dom.id(), node.id))
+            || node.element_data().is_some_and(|e| e.sub_doc_data().is_some())
+    }
+
+    fn render_node_now(
+        &self,
+        scene: &mut impl PaintScene,
+        node_id: NodeId,
+        parent_style_transform: Affine,
+        clip_rect: Rect,
+    ) {
+        let node = &self.dom.as_ref().tree()[node_id];
+
