+/// webui-lab: radial and conic gradients resolve their lengths (`circle 22px`, `at 30px 10px`, `transparent 25px`) in
+/// CSS px, but the tile they fill is in device px; so they are built for the tile in CSS px and scaled up after, or
+/// every px length came out `scale` times too small on a HiDPI screen (percentages were right).
+fn in_css_px(
+    rect: Rect,
+    scale: f64,
+    build: impl FnOnce(Rect) -> (peniko::Gradient, Option<Affine>),
+) -> (peniko::Gradient, Option<Affine>) {
+    if (scale - 1.0).abs() < 1e-9 || scale <= 0.0 {
+        return build(rect);
+    }
+    let css = Rect::new(rect.x0 / scale, rect.y0 / scale, rect.x1 / scale, rect.y1 / scale);
+    let (gradient, transform) = build(css);
+    (gradient, transform.map(|t| Affine::scale(scale) * t))
+}
