diff --git a/examples/webui_mutate.rs b/examples/webui_mutate.rs
new file mode 100644
index 0000000..b273037
--- /dev/null
+++ b/examples/webui_mutate.rs
@@ -0,0 +1,46 @@
+//! webui-lab: check that changing an inline SVG's attributes after load repaints it.
+use anyrender::render_to_buffer;
+use anyrender_vello_cpu::VelloCpuImageRenderer;
+use blitz_dom::{DocumentConfig, LocalName, QualName, ns};
+use blitz_html::HtmlDocument;
+use blitz_net::Provider;
+use blitz_paint::paint_scene;
+use blitz_traits::shell::{ColorScheme, Viewport};
+use reqwest::Url;
+use std::{fs::File, sync::Arc};
+
+#[tokio::main]
+async fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let input = std::fs::canonicalize(&a[1]).unwrap();
+    let (w, h) = (a[3].parse::<u32>().unwrap(), a[4].parse::<u32>().unwrap());
+    let html = std::fs::read_to_string(&input).unwrap();
+    let net = Arc::new(Provider::new(None));
+    let mut doc = HtmlDocument::from_html(&html, DocumentConfig {
+        base_url: Some(Url::from_file_path(&input).unwrap().to_string()),
+        net_provider: Some(Arc::clone(&net) as _),
+        viewport: Some(Viewport::new(w, h, 1.0, ColorScheme::Light)),
+        ..Default::default()
+    });
+    loop { doc.resolve(0.0); if net.is_empty() { break; } }
+    doc.as_mut().resolve(0.0);
+    let dx = w as f32 - 1422.0;
+    let shift = |d: &str| -> String {
+        let mut out = String::new(); let mut num = String::new();
+        let flush = |num: &mut String, out: &mut String| { if num.is_empty() { return; } let v: f32 = num.parse().unwrap(); out.push_str(&format!("{}", if v >= 1100.0 { v + dx } else { v })); num.clear(); };
+        for c in d.chars() { if c.is_ascii_digit() || c == '.' { num.push(c) } else { flush(&mut num, &mut out); out.push(c) } }
+        flush(&mut num, &mut out); out
+    };
+    let q = |n: &str| QualName::new(None, ns!(), LocalName::from(n));
+    for (id, d) in [("p-body", "M0 0H1422V68H1236Q1220 68 1214 60Q1206 50 1188 50H262Q246 50 240 62Q232 76 214 76H0Z"), ("p-edge", "M0 76H214Q232 76 240 62Q246 50 262 50H1188Q1206 50 1214 60Q1220 68 1236 68H1422")] {
+        let nid = doc.get_element_by_id(id).unwrap();
+        doc.mutate().set_attribute(nid, q("d"), &shift(d));
+    }
+    let f = doc.get_element_by_id("frame").unwrap();
+    doc.mutate().set_attribute(f, q("viewBox"), &format!("0 0 {w} 80"));
+    doc.as_mut().resolve(0.0);
+    let buf = render_to_buffer::<VelloCpuImageRenderer, _>(|s| paint_scene(s, doc.as_mut(), 1.0, w, h, 0, 0), w, h);
+    let mut enc = png::Encoder::new(File::create(&a[2]).unwrap(), w, h);
+    enc.set_color(png::ColorType::Rgba); enc.set_depth(png::BitDepth::Eight);
+    enc.write_header().unwrap().write_image_data(&buf).unwrap();
+}
diff --git a/examples/webui_render.rs b/examples/webui_render.rs
new file mode 100644
index 0000000..18e799c
--- /dev/null
+++ b/examples/webui_render.rs
@@ -0,0 +1,63 @@
+//! webui-lab: render a local HTML file to a transparent PNG with Blitz's CPU painter, for pixel comparison with Chrome.
+//! Usage: webui_render <in.html> <out.png> <css width> <css height> [scale] [unpremultiply 0/1]
+use anyrender::render_to_buffer;
+use anyrender_vello_cpu::VelloCpuImageRenderer;
+use blitz_dom::DocumentConfig;
+use blitz_html::HtmlDocument;
+use blitz_net::Provider;
+use blitz_paint::paint_scene;
+use blitz_traits::shell::{ColorScheme, Viewport};
+use reqwest::Url;
+use std::{fs::File, sync::Arc, time::Instant};
+
+#[tokio::main]
+async fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let input = std::fs::canonicalize(&a[1]).unwrap();
+    let out = &a[2];
+    let width: u32 = a[3].parse().unwrap();
+    let height: u32 = a[4].parse().unwrap();
+    let scale: f64 = a.get(5).and_then(|s| s.parse().ok()).unwrap_or(1.0);
+    let unpremul = a.get(6).map(|s| s == "1").unwrap_or(true);
+    let url = Url::from_file_path(&input).unwrap().to_string();
+    let html = std::fs::read_to_string(&input).unwrap();
+    let t0 = Instant::now();
+    let net = Arc::new(Provider::new(None));
+    let (pw, ph) = ((width as f64 * scale) as u32, (height as f64 * scale) as u32);
+    let mut doc = HtmlDocument::from_html(&html, DocumentConfig {
+        base_url: Some(url),
+        net_provider: Some(Arc::clone(&net) as _),
+        viewport: Some(Viewport::new(pw, ph, scale as f32, ColorScheme::Light)),
+        ..Default::default()
+    });
+    loop { doc.resolve(0.0); if net.is_empty() { break; } }
+    doc.as_mut().resolve(0.0);
+    let t1 = Instant::now();
+    let mut buf = render_to_buffer::<VelloCpuImageRenderer, _>(|scene| {
+        paint_scene(scene, doc.as_mut(), scale, pw, ph, 0, 0);
+    }, pw, ph);
+    let t2 = Instant::now();
+    // Steady-state repaints (caches warm), as a HUD repaints on hover.
+    let reps: u32 = std::env::var("REPS").ok().and_then(|v| v.parse().ok()).unwrap_or(0);
+    if reps > 0 {
+        let t = Instant::now();
+        for _ in 0..reps {
+            doc.as_mut().resolve(0.0);
+            let _ = render_to_buffer::<VelloCpuImageRenderer, _>(|scene| { paint_scene(scene, doc.as_mut(), scale, pw, ph, 0, 0); }, pw, ph);
+        }
+        println!("repaint avg {:?}", t.elapsed() / reps);
+    }
+    if unpremul {
+        for px in buf.chunks_exact_mut(4) {
+            let a = px[3] as u32;
+            if a > 0 && a < 255 { for c in 0..3 { px[c] = ((px[c] as u32 * 255 + a / 2) / a).min(255) as u8; } }
+        }
+    }
+    let mut enc = png::Encoder::new(File::create(out).unwrap(), pw, ph);
+    enc.set_color(png::ColorType::Rgba);
+    enc.set_depth(png::BitDepth::Eight);
+    let mut w = enc.write_header().unwrap();
+    w.write_image_data(&buf).unwrap();
+    w.finish().unwrap();
+    println!("style+layout {:?}, paint {:?}, {}x{}", t1 - t0, t2 - t1, pw, ph);
+}
