 /// Ensure that the `resized_image` field has a correctly sized image
+/// An area-averaged copy of `image` at `tw`×`th` (premultiplied), cached by source and size.
+fn downscaled(image: &RasterImageData, tw: u32, th: u32, quality: peniko::ImageQuality) -> peniko::ImageBrush {
+    use std::collections::HashMap;
+    use std::sync::{Mutex, OnceLock};
+    static CACHE: OnceLock<Mutex<HashMap<(u64, u32, u32), peniko::Blob<u8>>>> = OnceLock::new();
+    let key = (image.data.id(), tw, th);
+    let cache = CACHE.get_or_init(|| Mutex::new(HashMap::new()));
+    let blob = {
+        let mut map = cache.lock().unwrap();
+        if map.len() > 512 { map.clear(); }
+        map.entry(key).or_insert_with(|| {
+            let (sw, sh) = (image.width as usize, image.height as usize);
+            let src = image.data.data();
+            let (fx, fy) = (sw as f64 / tw as f64, sh as f64 / th as f64);
+            let mut out = vec![0u8; (tw * th * 4) as usize];
+            for oy in 0..th as usize {
+                let (y0, y1) = (oy as f64 * fy, (oy + 1) as f64 * fy);
+                for ox in 0..tw as usize {
+                    let (x0, x1) = (ox as f64 * fx, (ox + 1) as f64 * fx);
+                    let mut acc = [0.0f64; 4];
+                    let mut wsum = 0.0;
+                    for sy in y0.floor() as usize..(y1.ceil() as usize).min(sh) {
+                        let wy = (y1.min(sy as f64 + 1.0) - y0.max(sy as f64)).max(0.0);
+                        for sx in x0.floor() as usize..(x1.ceil() as usize).min(sw) {
+                            let wx = (x1.min(sx as f64 + 1.0) - x0.max(sx as f64)).max(0.0);
+                            let w = wx * wy;
+                            let i = (sy * sw + sx) * 4;
+                            let a = src[i + 3] as f64 / 255.0;
+                            for k in 0..3 { acc[k] += src[i + k] as f64 * a * w; }
+                            acc[3] += a * w;
+                            wsum += w;
+                        }
+                    }
+                    let o = (oy * tw as usize + ox) * 4;
+                    if wsum > 0.0 {
+                        for k in 0..3 { out[o + k] = (acc[k] / wsum).round().clamp(0.0, 255.0) as u8; }
+                        out[o + 3] = (acc[3] / wsum * 255.0).round().clamp(0.0, 255.0) as u8;
+                    }
+                }
+            }
+            peniko::Blob::new(std::sync::Arc::new(out))
+        }).clone()
+    };
+    peniko::ImageBrush {
+        image: ImageData { data: blob, format: peniko::ImageFormat::Rgba8, width: tw, height: th, alpha_type: peniko::ImageAlphaType::AlphaPremultiplied },
+        sampler: ImageSampler { x_extend: peniko::Extend::Pad, y_extend: peniko::Extend::Pad, quality, alpha: 1.0 },
+    }
+}
