diff --git a/crates/anyrender_svg/Cargo.toml b/crates/anyrender_svg/Cargo.toml
index 8fe5010..dc32253 100644
--- a/crates/anyrender_svg/Cargo.toml
+++ b/crates/anyrender_svg/Cargo.toml
@@ -24,4 +24,6 @@ anyrender = { workspace = true }
 peniko = { workspace = true }
 kurbo = { workspace = true }
 usvg = { workspace = true, default-features = false }
+# webui-lab: groups with SVG filters are rasterized by resvg, which follows browsers (filters in linearRGB, all primitives).
+resvg = { version = "0.48", default-features = false }
 image = { workspace = true, default-features = false, optional = true }
\ No newline at end of file
diff --git a/crates/anyrender_svg/src/render.rs b/crates/anyrender_svg/src/render.rs
index 2e9e1c4..fe7dc60 100644
--- a/crates/anyrender_svg/src/render.rs
+++ b/crates/anyrender_svg/src/render.rs
@@ -18,6 +18,14 @@ pub(crate) fn render_group<S: PaintScene, F: FnMut(&mut S, &usvg::Node)>(
         let transform = transform * util::to_affine(&node.abs_transform());
         match node {
             usvg::Node::Group(g) => {
+                // webui-lab: a group with SVG filters is drawn by resvg into an image (filters in linearRGB and every
+                // primitive, as browsers do) and placed on the canvas.
+                if !g.filters().is_empty() {
+                    if let Some((image, at)) = rasterize_filtered(node, g, global_transform) {
+                        scene.draw_image(image.as_ref(), at);
+                    }
+                    continue;
+                }
                 let alpha = g.opacity().get();
                 let is_fully_opaque = alpha >= 1.0;
                 let mix = util::to_mix(g.blend_mode());
@@ -210,3 +218,156 @@ fn stroke<S: PaintScene, F: FnMut(&mut S, &usvg::Node)>(
         }
     }
 }
+
+/// Rasterizes a filtered group with resvg at device resolution: returns the image (premultiplied RGBA8) and where it
+/// goes on the canvas.
+fn rasterize_filtered(node: &usvg::Node, g: &usvg::Group, global_transform: Affine) -> Option<(peniko::ImageBrush, Affine)> {
+    // The same group at the same place and size comes from the cache: a filtered SVG is costly to rasterize and a HUD
+    // repaints it on every hover.
+    use std::collections::HashMap;
+    use std::sync::{Mutex, OnceLock};
+    type Key = (usize, [i64; 6]);
+    static CACHE: OnceLock<Mutex<HashMap<Key, (peniko::ImageBrush, Affine)>>> = OnceLock::new();
+    let c6 = global_transform.as_coeffs();
+    let key: Key = (g as *const usvg::Group as usize, c6.map(|v| (v * 64.0).round() as i64));
+    let cache = CACHE.get_or_init(|| Mutex::new(HashMap::new()));
+    if let Some(hit) = cache.lock().unwrap().get(&key) {
+        return Some(hit.clone());
+    }
+    let made = rasterize_filtered_uncached(node, g, global_transform)?;
+    let mut map = cache.lock().unwrap();
+    if map.len() > 64 { map.clear(); }
+    map.insert(key, made.clone());
+    Some(made)
+}
+
+fn rasterize_filtered_uncached(node: &usvg::Node, g: &usvg::Group, global_transform: Affine) -> Option<(peniko::ImageBrush, Affine)> {
+    let r = g.abs_layer_bounding_box();
+    let rect = global_transform.transform_rect_bbox(kurbo::Rect::new(r.x() as f64, r.y() as f64, r.right() as f64, r.bottom() as f64));
+    let (x0, y0) = (rect.x0.floor(), rect.y0.floor());
+    let (w, h) = ((rect.x1.ceil() - x0) as u32, (rect.y1.ceil() - y0) as u32);
+    if w == 0 || h == 0 || w > 8192 || h > 8192 {
+        return None;
+    }
+    let mut pixmap = resvg::tiny_skia::Pixmap::new(w, h)?;
+    // resvg shifts the node by its own layer box first (pre_translate(-bbox)), so put that back.
+    let c = (Affine::translate((-x0, -y0)) * global_transform * Affine::translate((r.x() as f64, r.y() as f64))).as_coeffs();
+    let ts = resvg::tiny_skia::Transform::from_row(c[0] as f32, c[1] as f32, c[2] as f32, c[3] as f32, c[4] as f32, c[5] as f32);
+    let shadow = g.filters()[0].primitives().iter().find_map(|p| match p.kind() {
+        usvg::filter::Kind::DropShadow(ds) if g.filters().len() == 1 && g.filters()[0].primitives().len() == 1 => Some((ds.clone(), p.color_interpolation())),
+        _ => None,
+    });
+    match shadow {
+        // A lone feDropShadow: the content by resvg, the shadow and its compositing here in floating point. resvg works
+        // in 8-bit linear light, which crushes dark colours (a dark teal lost half its red).
+        Some((ds, ci)) => {
+            let scale = global_transform.as_coeffs();
+            for child in g.children() {
+                let Some(cb) = child.abs_layer_bounding_box() else { continue };
+                let c = (Affine::translate((-x0, -y0)) * global_transform * Affine::translate((cb.x() as f64, cb.y() as f64))).as_coeffs();
+                let cts = resvg::tiny_skia::Transform::from_row(c[0] as f32, c[1] as f32, c[2] as f32, c[3] as f32, c[4] as f32, c[5] as f32);
+                resvg::render_node(child, cts, &mut pixmap.as_mut());
+            }
+            let linear = matches!(ci, usvg::filter::ColorInterpolation::LinearRGB);
+            drop_shadow(pixmap.data_mut(), w as usize, h as usize, &ds, scale[0] as f32, scale[3] as f32, linear);
+        }
+        None => {
+            resvg::render_node(node, ts, &mut pixmap.as_mut())?;
+        }
+    }
+    let image = peniko::ImageBrush::new(peniko::ImageData {
+        data: peniko::Blob::new(std::sync::Arc::new(pixmap.take())),
+        format: peniko::ImageFormat::Rgba8,
+        alpha_type: peniko::ImageAlphaType::AlphaPremultiplied,
+        width: w,
+        height: h,
+    });
+    Some((image, Affine::translate((x0, y0))))
+}
+
+fn srgb_to_linear(c: f32) -> f32 { if c <= 0.04045 { c / 12.92 } else { ((c + 0.055) / 1.055).powf(2.4) } }
+fn linear_to_srgb(c: f32) -> f32 { if c <= 0.0031308 { c * 12.92 } else { 1.055 * c.max(0.0).powf(1.0 / 2.4) - 0.055 } }
+
+/// feDropShadow over premultiplied RGBA8 content, in place: the content's alpha blurred (σ in device px) and offset,
+/// flooded with the shadow colour, and the content laid over it, all in f32 and in linearRGB when asked (the SVG default).
+fn drop_shadow(px: &mut [u8], w: usize, h: usize, ds: &usvg::filter::DropShadow, sx: f32, sy: f32, linear: bool) {
+    let n = w * h;
+    let alpha: Vec<f32> = (0..n).map(|i| px[i * 4 + 3] as f32 / 255.0).collect();
+    let blurred = gaussian(&alpha, w, h, ds.std_dev_x().get() * sx.abs(), ds.std_dev_y().get() * sy.abs());
+    let (dx, dy) = ((ds.dx() * sx).round() as isize, (ds.dy() * sy).round() as isize);
+    let col = ds.color();
+    let to_space = |c: u8| { let v = c as f32 / 255.0; if linear { srgb_to_linear(v) } else { v } };
+    let flood = [to_space(col.red), to_space(col.green), to_space(col.blue)];
+    let flood_a = ds.opacity().get();
+    for y in 0..h {
+        for x in 0..w {
+            let i = y * w + x;
+            let (sxp, syp) = (x as isize - dx, y as isize - dy);
+            let sh = if sxp >= 0 && syp >= 0 && (sxp as usize) < w && (syp as usize) < h { blurred[syp as usize * w + sxp as usize] * flood_a } else { 0.0 };
+            let a = px[i * 4 + 3] as f32 / 255.0;
+            let mut out = [0.0f32; 3];
+            for k in 0..3 {
+                let src = if a > 0.0 { px[i * 4 + k] as f32 / 255.0 / a } else { 0.0 };
+                let src = if linear { srgb_to_linear(src) } else { src };
+                out[k] = src * a + flood[k] * sh * (1.0 - a);
+            }
+            let oa = a + sh * (1.0 - a);
+            for k in 0..3 {
+                let c = if oa > 0.0 { out[k] / oa } else { 0.0 };
+                let c = if linear { linear_to_srgb(c) } else { c };
+                px[i * 4 + k] = (c * oa * 255.0).round().clamp(0.0, 255.0) as u8;
+            }
+            px[i * 4 + 3] = (oa * 255.0).round().clamp(0.0, 255.0) as u8;
+        }
+    }
+}
+
+/// A Gaussian blur of a w×h plane approximated by three box blurs per axis, as the SVG filter spec describes for
+/// feGaussianBlur (and browsers do): O(pixels) whatever the σ. Edges count as transparent.
+fn gaussian(src: &[f32], w: usize, h: usize, sx: f32, sy: f32) -> Vec<f32> {
+    fn boxes(s: f32) -> (usize, bool) {
+        // d = floor(s * 3 * sqrt(2π) / 4 + 0.5); odd d: three boxes of size d centred; even d: two offset, one d+1.
+        let d = (s * 3.0 * (2.0 * std::f32::consts::PI).sqrt() / 4.0 + 0.5).floor() as usize;
+        (d, d % 2 == 0)
+    }
+    fn pass(line: &mut [f32], tmp: &mut [f32], size: usize, offset: isize) {
+        // A running box sum of `size` samples, its window starting `offset` before the pixel.
+        let n = line.len() as isize;
+        if size <= 1 { return; }
+        let mut sum = 0.0f32;
+        let start = -offset;
+        for i in 0..size as isize { let j = start + i; if j >= 0 && j < n { sum += line[j as usize]; } }
+        for x in 0..n {
+            tmp[x as usize] = sum / size as f32;
+            let out = x + start;
+            let inn = x + start + size as isize;
+            if out >= 0 && out < n { sum -= line[out as usize]; }
+            if inn >= 0 && inn < n { sum += line[inn as usize]; }
+        }
+        line.copy_from_slice(tmp);
+    }
+    fn three(line: &mut [f32], tmp: &mut [f32], s: f32) {
+        if s < 0.01 { return; }
+        let (d, even) = boxes(s);
+        if d <= 1 { return; }
+        if !even {
+            let r = (d / 2) as isize;
+            for _ in 0..3 { pass(line, tmp, d, r); }
+        } else {
+            let half = (d / 2) as isize;
+            pass(line, tmp, d, half);
+            pass(line, tmp, d, half - 1);
+            pass(line, tmp, d + 1, half);
+        }
+    }
+    let mut out = src.to_vec();
+    let mut tmp = vec![0.0f32; w.max(h)];
+    for y in 0..h { three(&mut out[y * w..(y + 1) * w], &mut tmp[..w], sx); }
+    let mut col = vec![0.0f32; h];
+    for x in 0..w {
+        for y in 0..h { col[y] = out[y * w + x]; }
+        three(&mut col, &mut tmp[..h], sy);
+        for y in 0..h { out[y * w + x] = col[y]; }
+    }
+    out
+}
